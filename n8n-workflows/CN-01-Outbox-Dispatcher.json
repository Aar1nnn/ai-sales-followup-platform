{
  "name": "CN-01 Outbox Dispatcher",
  "active": false,
  "nodes": [
    { "id": "schedule", "name": "Every Minute", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0], "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] } } },
    { "id": "claim", "name": "Claim Outbox Batch", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [240, 0], "parameters": { "method": "POST", "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/claim_outbox_events' }}", "authentication": "genericCredentialType", "genericAuthType": "httpCustomAuth", "sendBody": true, "contentType": "raw", "rawContentType": "application/json", "body": "={{ JSON.stringify({ p_worker_id: 'n8n:' + $execution.id, p_limit: 20 }) }}" }, "credentials": { "httpCustomAuth": { "name": "Supabase Service Role (n8n only)" } } },
    { "id": "route", "name": "Route Events", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [480, 0], "parameters": { "jsCode": "const feishuEnabled = String($vars.FEISHU_NOTIFICATIONS_ENABLED || 'false').toLowerCase() === 'true';\nconst feishuWorkflow = feishuEnabled ? $vars.WF_FEISHU_NOTIFY_ID : null;\nconst routes = {\n  'lead.intake.accepted': $vars.WF_AI_SCORE_ID,\n  'command.record_lead_score.succeeded': $vars.WF_ASSIGNMENT_ID,\n  'command.assign_lead.succeeded': $vars.WF_DRAFT_ID,\n  'command.regenerate_message_draft.succeeded': $vars.WF_DRAFT_ID,\n  'command.create_message_draft.succeeded': feishuWorkflow,\n  'command.reassign_lead.succeeded': feishuWorkflow,\n  'task.reminder.due': feishuWorkflow,\n  'organization.purge.due': $vars.WF_PURGE_ID\n};\nreturn items.map(({ json }) => ({ json: { ...json, workflow_id: routes[json.event_type] || null, worker_id: 'n8n:' + $execution.id } }));" } },
    { "id": "has-route", "name": "Has Route?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [700, 0], "parameters": { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 }, "conditions": [{ "id": "has-route-condition", "leftValue": "={{ Boolean($json.workflow_id) }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" } } },
    { "id": "execute", "name": "Execute Routed Workflow", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1.2, "position": [920, -80], "parameters": { "workflowId": { "__rl": true, "value": "={{ $json.workflow_id }}", "mode": "id" }, "options": { "waitForSubWorkflow": true } } },
    { "id": "complete", "name": "Complete Outbox Event", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1160, 0], "parameters": { "method": "POST", "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/complete_outbox_event' }}", "authentication": "genericCredentialType", "genericAuthType": "httpCustomAuth", "sendBody": true, "contentType": "raw", "rawContentType": "application/json", "body": "={{ JSON.stringify({ p_event_id: $('Has Route?').item.json.id, p_worker_id: $('Has Route?').item.json.worker_id }) }}" }, "credentials": { "httpCustomAuth": { "name": "Supabase Service Role (n8n only)" } } }
  ],
  "connections": { "Every Minute": { "main": [[{ "node": "Claim Outbox Batch", "type": "main", "index": 0 }]] }, "Claim Outbox Batch": { "main": [[{ "node": "Route Events", "type": "main", "index": 0 }]] }, "Route Events": { "main": [[{ "node": "Has Route?", "type": "main", "index": 0 }]] }, "Has Route?": { "main": [[{ "node": "Execute Routed Workflow", "type": "main", "index": 0 }], [{ "node": "Complete Outbox Event", "type": "main", "index": 0 }]] }, "Execute Routed Workflow": { "main": [[{ "node": "Complete Outbox Event", "type": "main", "index": 0 }]] } },
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "all", "saveDataSuccessExecution": "none" },
  "meta": { "templateVersion": "china-standard-v1", "credentialPolicy": "n8n-credentials-only", "feishuNotificationsDefault": false },
  "tags": [{ "name": "china-standard-v1" }]
}
