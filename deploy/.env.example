# Public build-time values
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=obtain-from-customer-supabase-dashboard
FRONTEND_PORT=8080

# Pin after customer acceptance testing; never use latest in production.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:replace-with-approved-version
N8N_PORT=5678
N8N_HOST=n8n.crm.customer.example
N8N_DB_PASSWORD=generate-a-long-random-password
N8N_ENCRYPTION_KEY=generate-and-back-up-a-32-byte-random-value

# Non-secret routing/config values. API keys belong in n8n Credentials.
SUPABASE_URL=https://PROJECT_REF.supabase.co
CRM_APP_URL=https://crm.customer.example
SYSTEM_ACTOR_USER_ID=customer-owned-active-admin-user-uuid
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_PROVIDER=aliyun_bailian
