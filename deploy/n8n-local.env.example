# Copy to deploy/.env.n8n.local through scripts/prepare-local-n8n.ps1.
# Never commit the generated file.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.30.5
N8N_PORT=5678
N8N_DB_PASSWORD=generated-locally
N8N_ENCRYPTION_KEY=generated-locally-and-never-rotated-without-a-migration
N8N_INTERNAL_SECRET=generated-locally-for-a-later-n8n-credential
SUPABASE_URL=https://PROJECT_REF.supabase.co
CRM_APP_URL=http://127.0.0.1:5173
SYSTEM_ACTOR_USER_ID=active-owner-or-admin-user-uuid
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_PROVIDER=aliyun_bailian
